# Generate real local secrets with: python3 scripts/init_env.py
POSTGRES_PASSWORD=replace_with_random_password
REDIS_PASSWORD=replace_with_random_password
DATABASE_URL=postgresql://setapi:replace_with_random_password@postgres:5432/setapi
REDIS_URL=redis://:replace_with_random_password@redis:6379/0
# A URL-safe base64-encoded 32-byte key. Keep a copy separately from your backups.
SETAPI_ENCRYPTION_KEY=replace_with_generated_key
SETAPI_ADMIN_EMAIL=admin@example.com
SETAPI_ADMIN_PASSWORD=replace_with_at_least_12_random_characters
SETAPI_PUBLIC_URL=http://localhost:8055
SETAPI_COOKIE_SECURE=false
SETAPI_CORS_ORIGINS=
SETAPI_MAX_UPLOAD_MB=50
# Behind a proxy: set FORWARDED_ALLOW_IPS to ONLY the trusted proxy address/network.
